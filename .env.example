# ==============================================================================
# ResearchAI - Production Environment Configuration Template
# ==============================================================================

# [Required] Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [Required] Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# [Optional] Primary Model (auto-falls back to flash / gemma models if busy)
GEMINI_MODEL=gemini-flash-latest

# [Security] Authorized Admin Telegram User IDs (Comma-separated integers)
ADMIN_USER_IDS=

# [Security] Per-User Request Rate Limit (Requests per minute)
RATE_LIMIT_PER_MINUTE=15

# [Production Webhook] Leave empty for Polling mode, or provide for Webhook hosting
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_PORT=8080

# [Optional] Web Search Limits
MAX_SEARCH_QUERIES=4
MAX_RESULTS_PER_QUERY=3
MAX_TOTAL_SOURCES=8

# [Optional] Timeouts (Seconds)
SEARCH_TIMEOUT_SECONDS=10
FETCH_TIMEOUT_SECONDS=8

# [Optional] Environment
APP_ENV=production
DEBUG=false
