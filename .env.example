# ==============================================================================
# ResearchAI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate your keys:
# cp .env.example .env

# [Required] Google Gemini API Key
# Obtain a free or paid API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [Optional] Primary Gemini Model to use
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# [Optional] Web Search Configuration
# Max search query terms to generate per research plan
MAX_SEARCH_QUERIES=4
# Max organic web results to extract per query
MAX_RESULTS_PER_QUERY=3
# Max source documents to analyze in deep cross-synthesis
MAX_TOTAL_SOURCES=8

# [Optional] Network & Request Timeouts (seconds)
SEARCH_TIMEOUT_SECONDS=10
FETCH_TIMEOUT_SECONDS=8

# [Optional] App Configuration
APP_ENV=development
DEBUG=false
